# mock = deterministic, offline (default, used for client demos); live = Anthropic API
LLM_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Seed for synthetic data generation (same seed -> same data -> same agent outputs)
SEED=42
# All synthetic dates are relative to this date (YYYY-MM-DD). Empty = today.
DEMO_TODAY=
# Where tenant SQLite files live
DATA_DIR=data
